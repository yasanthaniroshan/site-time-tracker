{
  "manifest_version": 3,
  "name": "Site Time Tracker",
  "version": "1.0.0",
  "description": "Shows how much time you've spent today on YouTube and LinkedIn, in 5-minute blocks.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Site Time Tracker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "background": { "service_worker": "src/background.js" },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": [
        "src/content/config.js",
        "src/content/widget.js",
        "src/content/tracker.js"
      ]
    }
  ]
}
